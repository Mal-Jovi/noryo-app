generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Patient {
  id                 Int          @id @default(autoincrement())
  phn                String       @unique
  firstName          String
  lastName           String
  city               String
  province           String
  gender             Gender
  age                Int
  birthday           DateTime
  familyDoctorId     Int?
  primaryDoctorId    Int
  lastClinicVisit    DateTime?
  nextClinicVisit    DateTime?
  allergies          Json
  primaryCondition   Json
  secondaryCondition Json
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  familyDoctor       Doctor?      @relation("PatientFamilyDoctor", fields: [familyDoctorId], references: [id])
  primaryDoctor      Doctor       @relation("PatientPrimaryDoctor", fields: [primaryDoctorId], references: [id])
  medications        Medication[] @relation("PatientMedications")

  @@index([lastClinicVisit])
  @@index([nextClinicVisit])
  @@index([province])
  @@index([gender])
  @@index([lastName, firstName])
  @@index([familyDoctorId], map: "Patient_familyDoctorId_fkey")
  @@index([primaryDoctorId], map: "Patient_primaryDoctorId_fkey")
}

model Doctor {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  createdAt       DateTime  @default(now())
  licenseNumber   String    @unique
  email           String    @unique
  specialty       String
  familyPatients  Patient[] @relation("PatientFamilyDoctor")
  primaryPatients Patient[] @relation("PatientPrimaryDoctor")

  @@index([specialty])
  @@index([lastName])
}

model Medication {
  drugIdentificationNumber String    @unique
  genericName              String
  brandName                String
  type                     String
  drugClass                String
  controlledSubstance      Boolean
  id                       Int       @id @default(autoincrement())
  patients                 Patient[] @relation("PatientMedications")

  @@index([type])
  @@index([brandName])
  @@index([genericName, brandName])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}
